# 现场生成密码；不要提交 .env
POSTGRES_PASSWORD=replace-with-a-generated-local-password

# 服务器部署先创建管理员账号，再关闭演示登录。
AUTH_USERS_FILE=/run/dtv-auth/users.json
DEMO_ENABLED=false
# 通过 HTTPS 反向代理访问时保持 true；纯本机 HTTP 演示需改为 false。
COOKIE_SECURE=true
# 默认仅本机反向代理可访问；需要直连时结合防火墙/TLS 评估后修改。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# 天地图浏览器端 Key；登录后由 API 配置接口用于影像和 swdx 高程请求，请限制授权域名。
TDT_API_KEY=replace-with-your-tianditu-key
# Cesium ion 访问令牌；仅授权地形资源，并将允许来源限制为站点 Origin（协议、主机和端口），勿提交真实令牌。
CESIUM_ION_ACCESS_TOKEN=replace-with-your-cesium-ion-token

# 当前仍为Mock验收模式；许可证可以独立强制启用，production启动闸门保持关闭。
DEPLOYMENT_MODE=demo
LICENSE_REQUIRED=true
# 仅此服务器配置可授予平台管理员身份，账号自身还须为启用的admin。
PLATFORM_ADMIN_IDS=admin
# 公钥放deploy/licensing/trust-roots.json，签发私钥留在仓库之外。
# 自定义后端扩展映射可放deploy/licensing/extension-services.json。
DTV_EXTENSION_SERVICES_FILE=
