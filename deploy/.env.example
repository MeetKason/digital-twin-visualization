# 现场生成密码；不要提交 .env
POSTGRES_PASSWORD=replace-with-a-generated-local-password

# 服务器部署先创建管理员账号，再关闭演示登录。
AUTH_USERS_FILE=/run/dtv-auth/users.json
DEMO_ENABLED=false
# 通过 HTTPS 反向代理访问时保持 true；纯本机 HTTP 演示需改为 false。
COOKIE_SECURE=true
# 默认仅本机反向代理可访问；需要直连时结合防火墙/TLS 评估后修改。
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
